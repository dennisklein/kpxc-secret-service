#!/usr/bin/python3
"""Manage KeePassXC as Secret Service provider on a private D-Bus bus.

KeePassXC runs as the systemd user service kpxc-secret-service.service with
the private bus $XDG_RUNTIME_DIR/kpxc-bus as its session bus. The desktop
keeps its own Secret Service (e.g. GNOME Keyring) on the regular session bus.
"""

import argparse
import os
import pwd
import subprocess
import sys
import tempfile
from pathlib import Path

USERS_DIR = Path("/etc/kpxc-secret-service/users.d")
SOCKET_UNIT = "kpxc-bus.socket"
BUS_UNIT = "kpxc-bus.service"
MAIN_UNIT = "kpxc-secret-service.service"
RELAY_UNIT = "kpxc-lock-relay.service"
UNITS = (SOCKET_UNIT, BUS_UNIT, MAIN_UNIT, RELAY_UNIT)
DESKTOP_ID = "org.keepassxc.KeePassXC.desktop"
SYSTEM_DESKTOP_FILE = Path("/usr/share/applications") / DESKTOP_ID
MENU_MARKER = "X-KPXC-Secret-Service=true"
KEEPASSXC_NAME = "org.keepassxc.KeePassXC.MainWindow"
SECRETS_NAME = "org.freedesktop.secrets"
SELF = "/usr/bin/kpxc-secret-service"
# Lowest regular (non-system) UID on Fedora, matching ConditionUser=!@system.
FIRST_REGULAR_UID = 1000

# Exec= of the generated menu entry. Falls back to plain keepassxc if this
# package is gone but the entry is left behind in the user's home. Quoting
# follows the Desktop Entry spec: \" and \$ inside the quoted argument, with
# each backslash doubled again for the key file.
MENU_EXEC = (
    rf'sh -c "[ -x {SELF} ] && exec {SELF} open \\"\\$@\\"; '
    r'exec keepassxc \\"\\$@\\"" kpxc-secret-service'
)


def _xdg_dir(variable, fallback):
    value = os.environ.get(variable, "")
    return Path(value) if os.path.isabs(value) else Path.home() / fallback


CONFIG_HOME = _xdg_dir("XDG_CONFIG_HOME", ".config")
DATA_HOME = _xdg_dir("XDG_DATA_HOME", ".local/share")
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
STATE_DIR = CONFIG_HOME / "kpxc-secret-service"
USER_MARKER = STATE_DIR / "enabled"
SETUP_STAMP = STATE_DIR / "setup-done"
PRIVATE_SOCKET = RUNTIME_DIR / "kpxc-bus"
PRIVATE_BUS = f"unix:path={PRIVATE_SOCKET}"
KEEPASSXC_INI = Path(os.environ.get("KPXC_CONFIG") or CONFIG_HOME / "keepassxc" / "keepassxc.ini")
AUTOSTART_FILE = CONFIG_HOME / "autostart" / DESKTOP_ID
MENU_OVERRIDE = DATA_HOME / "applications" / DESKTOP_ID


class Error(Exception):
    pass


def username():
    return pwd.getpwuid(os.getuid()).pw_name


def is_root():
    return os.geteuid() == 0


# systemd ------------------------------------------------------------------


def systemctl(*args, user=None, quiet=False):
    """Run `systemctl --user`, for another user's manager if `user` is given."""
    cmd = ["systemctl", "--user"]
    if user:
        cmd.append(f"--machine={user}@.host")
    out = subprocess.DEVNULL if quiet else None
    return subprocess.run([*cmd, *args], stdout=out, stderr=out, check=False).returncode


def systemctl_query(*args, user=None):
    cmd = ["systemctl", "--user"]
    if user:
        cmd.append(f"--machine={user}@.host")
    result = subprocess.run([*cmd, *args], capture_output=True, text=True, check=False)
    return result.stdout.strip() or "unknown"


def unit_state(unit, user=None):
    return systemctl_query("is-active", unit, user=user)


def manager_running(uid):
    return subprocess.run(
        ["systemctl", "is-active", "--quiet", f"user@{uid}.service"],
        stderr=subprocess.DEVNULL, check=False,
    ).returncode == 0


# D-Bus --------------------------------------------------------------------


def connect(address=None):
    """Connection to the bus at `address` (default: desktop session bus) or None."""
    from gi.repository import Gio, GLib

    try:
        if address is None:
            return Gio.bus_get_sync(Gio.BusType.SESSION, None)
        return Gio.DBusConnection.new_for_address_sync(
            address,
            Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT
            | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION,
            None,
            None,
        )
    except GLib.Error:
        return None


def call(connection, destination, path, interface, method, args, reply_type):
    from gi.repository import Gio, GLib

    try:
        return connection.call_sync(
            destination, path, interface, method, args,
            GLib.VariantType(reply_type), Gio.DBusCallFlags.NO_AUTO_START, 3000, None,
        ).unpack()
    except GLib.Error:
        return None


def name_owner(connection, name):
    """(pid, command name) of the owner of `name`, or None (never activates)."""
    from gi.repository import GLib

    if connection is None:
        return None
    dbus = ("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus")
    has_owner = call(connection, *dbus, "NameHasOwner", GLib.Variant("(s)", (name,)), "(b)")
    if not has_owner or not has_owner[0]:
        return None
    pid = call(connection, *dbus, "GetConnectionUnixProcessID", GLib.Variant("(s)", (name,)), "(u)")
    if not pid:
        return (None, "unknown")
    try:
        comm = Path(f"/proc/{pid[0]}/comm").read_text().strip()
    except OSError:
        comm = "unknown"
    return (pid[0], comm)


def describe_owner(owner):
    return "nobody" if owner is None else f"{owner[1]} (PID {owner[0]})"


def foreign_keepassxc():
    """Owner of KeePassXC's window on the desktop bus, i.e. outside the service."""
    return name_owner(connect(), KEEPASSXC_NAME)


def private_bus():
    """Connection to the private bus, without socket-activating an idle one."""
    if unit_state(BUS_UNIT) != "active":
        return None
    return connect(PRIVATE_BUS)


# Files --------------------------------------------------------------------


def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        mode = path.stat().st_mode & 0o777
    except FileNotFoundError:
        umask = os.umask(0)
        os.umask(umask)
        mode = 0o666 & ~umask
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def ini_get(path, section, key):
    try:
        lines = path.read_text().splitlines()
    except FileNotFoundError:
        return None
    current = None
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            current = stripped[1:-1]
        elif current == section and "=" in stripped:
            name, value = stripped.split("=", 1)
            if name.strip() == key:
                return value.strip()
    return None


def ini_set(path, section, key, value):
    """Set key=value in a QSettings INI file, keeping all other lines as they are."""
    path = path.resolve()  # write through symlinks, e.g. from dotfile managers
    try:
        lines = path.read_text().splitlines(keepends=True)
    except FileNotFoundError:
        lines = []
    out, in_section, done = [], False, False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            in_section = stripped == f"[{section}]"
            out.append(line if line.endswith("\n") else line + "\n")
            if in_section and not done:
                out.append(f"{key}={value}\n")
                done = True
        elif in_section and "=" in stripped and stripped.split("=", 1)[0].strip() == key:
            continue
        else:
            out.append(line)
    if not done:
        if out and not out[-1].endswith("\n"):
            out[-1] += "\n"
        if out and out[-1].strip():
            out.append("\n")
        out += [f"[{section}]\n", f"{key}={value}\n"]
    atomic_write(path, "".join(out))


def is_our_menu_entry(path):
    try:
        return MENU_MARKER in path.read_text().splitlines()
    except OSError:
        return False


def render_menu_entry(stock):
    """KeePassXC's menu entry, but starting KeePassXC through the service."""
    out = [
        f"# Generated by kpxc-secret-service from {SYSTEM_DESKTOP_FILE}.",
        "# Removed by `kpxc-secret-service disable`.",
    ]
    for line in stock.splitlines():
        if line.startswith("Exec="):
            command, _, rest = line[len("Exec="):].partition(" ")
            if os.path.basename(command) == "keepassxc":
                line = f"Exec={MENU_EXEC} {rest}".rstrip()
        elif line.startswith("StartupNotify="):
            # The window belongs to the service's process, not the one launched.
            line = "StartupNotify=false"
        out.append(line)
        if line.strip() == "[Desktop Entry]":
            out.append(MENU_MARKER)
    return "\n".join(out) + "\n"


# Per-user setup -----------------------------------------------------------


def install_menu_entry():
    if MENU_OVERRIDE.exists() and not is_our_menu_entry(MENU_OVERRIDE):
        print(f"Leaving {MENU_OVERRIDE} alone: not created by kpxc-secret-service.")
        return
    if not SYSTEM_DESKTOP_FILE.exists():
        print(f"No {SYSTEM_DESKTOP_FILE}; not adding a KeePassXC menu entry.")
        return
    content = render_menu_entry(SYSTEM_DESKTOP_FILE.read_text())
    if MENU_OVERRIDE.exists() and MENU_OVERRIDE.read_text() == content:
        return
    new = not MENU_OVERRIDE.exists()
    atomic_write(MENU_OVERRIDE, content)
    if new:
        print(f"Added a KeePassXC menu entry that starts KeePassXC through the service ({MENU_OVERRIDE}).")


def remove_menu_entry():
    if is_our_menu_entry(MENU_OVERRIDE):
        MENU_OVERRIDE.unlink()
        print(f"Removed the KeePassXC menu entry override ({MENU_OVERRIDE}).")


def setup(once):
    """Prepare the user's KeePassXC configuration for running under the service.

    With `once`, the full setup runs only until it has completed once; later
    runs just refresh the generated menu entry.
    """
    if once and SETUP_STAMP.exists():
        if MENU_OVERRIDE.exists():
            install_menu_entry()
        return

    complete = True
    if ini_get(KEEPASSXC_INI, "FdoSecrets", "Enabled") != "true":
        if foreign_keepassxc() or name_owner(private_bus(), KEEPASSXC_NAME):
            print("KeePassXC is running, so its Secret Service integration was not enabled; "
                  "quit KeePassXC and run `kpxc-secret-service setup`, or enable it in "
                  "Settings → Secret Service Integration.")
            complete = False
        else:
            ini_set(KEEPASSXC_INI, "FdoSecrets", "Enabled", "true")
            print(f"Enabled KeePassXC's Secret Service integration ({KEEPASSXC_INI}).")

    if AUTOSTART_FILE.exists():
        AUTOSTART_FILE.unlink()
        print(f"Removed KeePassXC's own autostart entry ({AUTOSTART_FILE}); "
              f"{MAIN_UNIT} starts KeePassXC at login instead.")

    install_menu_entry()

    if complete:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        SETUP_STAMP.touch()


# Commands -----------------------------------------------------------------


def require_user(command):
    if is_root():
        raise Error(f"run `kpxc-secret-service {command}` as the desktop user, not as root")


def lookup_regular_user(name):
    try:
        entry = pwd.getpwnam(name)
    except KeyError:
        raise Error(f"no such user: {name}") from None
    if entry.pw_uid < FIRST_REGULAR_UID or entry.pw_uid == 65534:
        raise Error(f"{name} is a system user")
    return entry


def opted_in():
    return USER_MARKER.exists() or (USERS_DIR / username()).exists()


def cmd_enable(args):
    if is_root():
        return admin_enable(args.users)
    if args.users:
        raise Error("only root can enable other users; run `kpxc-secret-service enable` to enable yourself")

    owner = foreign_keepassxc()
    if owner:
        raise Error(f"KeePassXC is running ({describe_owner(owner)}); quit it first, "
                    "so that it can be restarted on the private bus")

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    USER_MARKER.touch()
    print(f"Enabled kpxc-secret-service for {username()} ({USER_MARKER}).")
    setup(once=False)

    if systemctl("start", SOCKET_UNIT) != 0:
        print("The private bus will be available at your next login.")
    elif unit_state("graphical-session.target") != "active":
        print("KeePassXC starts with your next graphical session.")
    elif systemctl("start", MAIN_UNIT) != 0:
        print(f"Starting KeePassXC failed, see `journalctl --user -u {MAIN_UNIT}`.")
    print("\nNext: in KeePassXC, pick the group each database exposes "
          "(Database → Database Settings → Secret Service Integration). Then try:\n"
          "  kpxc-secret store --label='kpxc test' kpxc test\n"
          "  kpxc-secret lookup kpxc test")
    return 0


def admin_enable(users):
    if not users:
        raise Error("as root, name the user(s) to enable, e.g. `kpxc-secret-service enable alice`")
    entries = [lookup_regular_user(name) for name in users]
    USERS_DIR.mkdir(parents=True, exist_ok=True)
    for entry in entries:
        name = entry.pw_name
        (USERS_DIR / name).touch()
        print(f"Enabled kpxc-secret-service for {name} ({USERS_DIR / name}).")
        if not manager_running(entry.pw_uid):
            print("  Takes effect at their next login.")
            continue
        systemctl("start", SOCKET_UNIT, user=name)
        if unit_state("graphical-session.target", user=name) == "active":
            systemctl("start", MAIN_UNIT, user=name)
            print(f"  Started KeePassXC in their session: {unit_state(MAIN_UNIT, user=name)}.")
        else:
            print("  KeePassXC starts with their next graphical session.")
    return 0


def cmd_disable(args):
    if is_root():
        return admin_disable(args.users)
    if args.users:
        raise Error("only root can disable other users; run `kpxc-secret-service disable` to disable yourself")

    USER_MARKER.unlink(missing_ok=True)
    admin_marker = USERS_DIR / username()
    if admin_marker.exists():
        print(f"Your administrator enabled kpxc-secret-service for you ({admin_marker}).\n"
              "To opt out anyway: systemctl --user mask kpxc-bus.socket kpxc-secret-service.service")
        return 0

    SETUP_STAMP.unlink(missing_ok=True)
    systemctl("stop", MAIN_UNIT, BUS_UNIT, SOCKET_UNIT)
    print(f"Disabled kpxc-secret-service for {username()}.")
    remove_menu_entry()
    # With the desktop's Secret Service on the session bus, KeePassXC's
    # integration only works under kpxc-secret-service.
    if ini_get(KEEPASSXC_INI, "FdoSecrets", "Enabled") == "true":
        if foreign_keepassxc():
            print("Turn off Settings → Secret Service Integration in KeePassXC, "
                  "since GNOME Keyring owns the desktop session bus.")
        else:
            ini_set(KEEPASSXC_INI, "FdoSecrets", "Enabled", "false")
            print(f"Disabled KeePassXC's Secret Service integration ({KEEPASSXC_INI}).")
    return 0


def admin_disable(users):
    if not users:
        raise Error("as root, name the user(s) to disable, e.g. `kpxc-secret-service disable alice`")
    for name in users:
        marker = USERS_DIR / name
        if not marker.exists():
            print(f"{name} was not enabled by the administrator ({marker} does not exist).")
            continue
        marker.unlink()
        print(f"Disabled kpxc-secret-service for {name}.")
        try:
            entry = pwd.getpwnam(name)
        except KeyError:
            continue
        if (Path(entry.pw_dir) / ".config/kpxc-secret-service/enabled").exists():
            print(f"  {name} also enabled it themselves, so it stays active for them.")
        elif manager_running(entry.pw_uid):
            systemctl("stop", MAIN_UNIT, BUS_UNIT, SOCKET_UNIT, user=name)
        print("  Their KeePassXC settings and menu entry stay until they run `kpxc-secret-service disable`.")
    return 0


def cmd_setup(args):
    require_user("setup")
    setup(once=args.once)
    return 0


def cmd_open(args):
    require_user("open")
    if opted_in():
        # Returns once KeePassXC is up on the private bus (see ExecStartPost).
        systemctl("start", MAIN_UNIT, quiet=True)
    # With the service running, this second instance only hands over the
    # files, raises the window and exits. Otherwise (not enabled, or KeePassXC
    # already runs outside of the service) it acts like the stock menu entry.
    os.execvp("keepassxc", ["keepassxc", *args.files])


def cmd_list(_args):
    users = sorted(p.name for p in USERS_DIR.iterdir()) if USERS_DIR.is_dir() else []
    for name in users:
        print(name)
    return 0


def cmd_address(_args):
    print(PRIVATE_BUS)
    return 0


def cmd_status(args):
    if is_root():
        if not args.user:
            print(f"Enabled by the administrator ({USERS_DIR}):")
            return cmd_list(args)
        entry = lookup_regular_user(args.user)
        print(f"Administrator opt-in: {'yes' if (USERS_DIR / entry.pw_name).exists() else 'no'}")
        if not manager_running(entry.pw_uid):
            print(f"{entry.pw_name} has no running user manager.")
            return 0
        for unit in UNITS:
            print(f"{unit:30} {unit_state(unit, user=entry.pw_name)}")
        return 0

    if args.user and args.user != username():
        raise Error("only root can show the status of other users")
    if (USERS_DIR / username()).exists():
        opt_in = f"yes, by the administrator ({USERS_DIR / username()})"
    elif USER_MARKER.exists():
        opt_in = f"yes ({USER_MARKER})"
    else:
        opt_in = "no (run `kpxc-secret-service enable`)"
    print(f"{'Enabled:':30}{opt_in}")
    for unit in UNITS:
        print(f"{unit + ':':30}{unit_state(unit)}")
    print(f"{'Private bus:':30}{PRIVATE_BUS}")
    bus = private_bus()
    if bus is None:
        print(f"{'  Secret Service:':30}(bus idle, starts on first use)")
    else:
        print(f"{'  Secret Service:':30}{describe_owner(name_owner(bus, SECRETS_NAME))}")
    print("Desktop session bus:")
    print(f"{'  Secret Service:':30}{describe_owner(name_owner(connect(), SECRETS_NAME))}")
    return 0


def cmd_doctor(_args):
    require_user("doctor")
    from gi.repository import GLib

    problems = 0

    def report(level, message, hint=None):
        nonlocal problems
        problems += level == "FAIL"
        print(f"[{level:^4}] {message}")
        if hint:
            print(f"       → {hint}")

    if opted_in():
        report("OK", "kpxc-secret-service is enabled for you")
    else:
        report("FAIL", "kpxc-secret-service is not enabled for you", "kpxc-secret-service enable")

    for command, needed in (("keepassxc", True), ("dbus-broker-launch", True),
                            ("gdbus", True), ("secret-tool", False)):
        if any(os.access(Path(d) / command, os.X_OK) for d in os.get_exec_path()):
            continue
        report("FAIL" if needed else "WARN", f"{command} is not installed")

    for unit, at_login in ((SOCKET_UNIT, "the private bus"), (MAIN_UNIT, "KeePassXC")):
        state = systemctl_query("is-enabled", unit)
        if state == "masked":
            report("FAIL", f"{unit} is masked", f"systemctl --user unmask {unit}")
        elif state not in ("enabled", "enabled-runtime", "static", "alias"):
            report("WARN", f"{unit} is {state}: {at_login} does not start at login",
                   f"systemctl --user enable {unit}")

    graphical = unit_state("graphical-session.target") == "active"
    if not graphical:
        report("WARN", "not in a graphical session: KeePassXC can only start inside one")

    if unit_state(SOCKET_UNIT) == "active" and PRIVATE_SOCKET.is_socket():
        report("OK", f"private bus is listening at {PRIVATE_SOCKET}")
    else:
        report("FAIL", f"private bus socket {PRIVATE_SOCKET} is not listening",
               f"systemctl --user start {SOCKET_UNIT}")

    foreign = foreign_keepassxc()
    if foreign:
        report("FAIL", f"KeePassXC runs outside of the service: {describe_owner(foreign)}",
               "quit KeePassXC, then: kpxc-secret-service open")

    main_state = unit_state(MAIN_UNIT)
    if main_state == "active":
        report("OK", f"{MAIN_UNIT} is running")
    elif main_state == "failed":
        report("FAIL", f"{MAIN_UNIT} failed", f"journalctl --user -u {MAIN_UNIT}")
    else:
        report("OK", f"{MAIN_UNIT} is {main_state}; it starts at login, on demand or from the menu")

    if ini_get(KEEPASSXC_INI, "FdoSecrets", "Enabled") == "true":
        report("OK", "KeePassXC's Secret Service integration is enabled")
    else:
        report("FAIL", f"KeePassXC's Secret Service integration is disabled ({KEEPASSXC_INI})",
               "kpxc-secret-service setup, or KeePassXC → Settings → Secret Service Integration")

    bus = private_bus()
    owner = name_owner(bus, SECRETS_NAME)
    if main_state == "active":
        if owner is None:
            report("FAIL", f"KeePassXC is running but does not own {SECRETS_NAME} on the private bus",
                   "KeePassXC → Settings → Secret Service Integration")
        elif owner[1] != "keepassxc":
            report("WARN", f"{SECRETS_NAME} on the private bus is owned by {describe_owner(owner)}")
        else:
            report("OK", f"KeePassXC serves {SECRETS_NAME} on the private bus")
            collections = call(bus, SECRETS_NAME, "/org/freedesktop/secrets",
                               "org.freedesktop.DBus.Properties", "Get",
                               GLib.Variant("(ss)", ("org.freedesktop.Secret.Service", "Collections")),
                               "(v)")
            if collections is not None and not collections[0]:
                report("WARN", "no KeePassXC database is exposed as a collection",
                       "unlock a database and pick its exposed group in "
                       "Database → Database Settings → Secret Service Integration")

    desktop_owner = name_owner(connect(), SECRETS_NAME)
    if desktop_owner and desktop_owner[1] == "keepassxc":
        report("WARN", f"KeePassXC owns {SECRETS_NAME} on the desktop bus as well")
    else:
        report("OK", f"desktop Secret Service: {describe_owner(desktop_owner)}")

    if AUTOSTART_FILE.exists():
        report("WARN", f"KeePassXC's own autostart entry exists and races with the service ({AUTOSTART_FILE})",
               "kpxc-secret-service setup")

    if is_our_menu_entry(MENU_OVERRIDE):
        report("OK", "KeePassXC menu entry starts KeePassXC through the service")
    elif MENU_OVERRIDE.exists():
        report("WARN", f"custom KeePassXC menu entry {MENU_OVERRIDE} bypasses the service")
    else:
        report("WARN", "the KeePassXC menu entry starts KeePassXC outside of the service",
               "kpxc-secret-service setup")

    if main_state == "active" and unit_state(RELAY_UNIT) != "active":
        if systemctl_query("is-enabled", RELAY_UNIT) == "masked":
            report("OK", f"{RELAY_UNIT} is masked: databases do not lock with the screen")
        else:
            report("WARN", f"{RELAY_UNIT} is not running: databases do not lock with the screen",
                   f"journalctl --user -u {RELAY_UNIT}")

    return 1 if problems else 0


def main():
    parser = argparse.ArgumentParser(
        prog="kpxc-secret-service",
        description="Run KeePassXC as Secret Service on a private D-Bus bus "
                    "($XDG_RUNTIME_DIR/kpxc-bus), next to the desktop's own Secret Service.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="examples:\n"
               "  kpxc-secret-service enable             enable for yourself\n"
               "  sudo kpxc-secret-service enable bob    enable for user bob\n"
               "  kpxc-secret lookup service github      secret-tool against KeePassXC\n"
               "  kpxc-run git credential-libsecret get  any client against KeePassXC",
    )
    commands = parser.add_subparsers(dest="command", required=True, metavar="COMMAND")

    p = commands.add_parser("enable", help="opt in (root: opt in USERs) and start")
    p.add_argument("users", nargs="*", metavar="USER")
    p.set_defaults(func=cmd_enable)
    p = commands.add_parser("disable", help="opt out (root: opt out USERs) and stop")
    p.add_argument("users", nargs="*", metavar="USER")
    p.set_defaults(func=cmd_disable)
    p = commands.add_parser("status", help="show what runs where")
    p.add_argument("user", nargs="?", metavar="USER")
    p.set_defaults(func=cmd_status)
    p = commands.add_parser("doctor", help="diagnose common problems")
    p.set_defaults(func=cmd_doctor)
    p = commands.add_parser("setup", help="configure KeePassXC and its menu entry for the service")
    p.add_argument("--once", action="store_true", help="only until it has succeeded once")
    p.set_defaults(func=cmd_setup)
    p = commands.add_parser("open", help="start or raise KeePassXC through the service")
    p.add_argument("files", nargs="*", metavar="FILE")
    p.set_defaults(func=cmd_open)
    p = commands.add_parser("list", help="list users enabled by the administrator")
    p.set_defaults(func=cmd_list)
    p = commands.add_parser("address", help="print the private bus address")
    p.set_defaults(func=cmd_address)

    args = parser.parse_args()
    try:
        return args.func(args)
    except (Error, OSError) as e:
        print(f"kpxc-secret-service: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
