[Unit]
Description=KeePassXC serving the Secret Service API on a private D-Bus bus
Documentation=file:///usr/share/doc/kpxc-secret-service/README.md
# KeePassXC is a GUI application: run it only inside a graphical session.
PartOf=graphical-session.target
Requisite=graphical-session.target
After=graphical-session.target
# KeePassXC cannot reconnect to a restarted bus, so it lives and dies with it.
BindsTo=kpxc-bus.service
After=kpxc-bus.service
Wants=kpxc-lock-relay.service
# Same opt-in as kpxc-bus.socket.
ConditionUser=!@system
ConditionPathExists=|/etc/kpxc-secret-service/users.d/%u
ConditionPathExists=|%E/kpxc-secret-service/enabled

[Service]
Type=exec
# First start for a user: enable KeePassXC's Secret Service integration, add
# the KeePassXC menu entry that goes through this service, and drop
# KeePassXC's own autostart entry, which would race with this service.
ExecStartPre=-/usr/bin/kpxc-secret-service setup --once
# Extra arguments for keepassxc, e.g. via `systemctl --user edit`:
#   [Service]
#   Environment=KEEPASSXC_ARGS=--minimized
Environment=KEEPASSXC_ARGS=
ExecStart=/usr/libexec/kpxc-secret-service/kpxc-keepassxc $KEEPASSXC_ARGS
# Become active only once KeePassXC is on the bus, so `systemctl --user start`
# returns when it is usable.
ExecStartPost=-/usr/bin/gdbus wait --address unix:path=%t/kpxc-bus --timeout 30 org.keepassxc.KeePassXC.MainWindow
# Quitting KeePassXC from its menu exits 0 and leaves it stopped until it is
# needed again (D-Bus activation, menu entry) or the next login.
Restart=on-failure
RestartSec=2s
# kpxc-keepassxc exits 75 when another KeePassXC instance is in the way.
RestartPreventExitStatus=75
Slice=app.slice

[Install]
WantedBy=graphical-session.target
Also=kpxc-bus.socket
